<Window x:Class="CMW.SubjectMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑课程简称"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E8EBF0">

    <Window.Resources>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="编辑课程简称"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#202020"
                       FontFamily="Microsoft YaHei UI"/>
            <TextBlock Text="左侧课表常驻窗口会显示这里设置的简称；未设置则用全名"
                       FontSize="12" Foreground="#808080"
                       FontFamily="Microsoft YaHei UI"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E1E1E1"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="新增 / 更新"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#202020"
                           FontFamily="Microsoft YaHei UI"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtSubject"
                             Grid.Column="0"
                             ToolTip="课程原名称，如：数学"/>
                    <TextBlock Grid.Column="1" Text=" → "
                               VerticalAlignment="Center"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               Foreground="#606060"/>
                    <TextBox x:Name="txtShortName"
                             Grid.Column="2"
                             ToolTip="简称，如：数"/>
                    <Button Grid.Column="3"
                            Content="添加 / 更新"
                            Style="{StaticResource PclButtonPrimary}"
                            Margin="10,0,0,0"
                            Click="BtnAdd_Click"/>
                </Grid>
                <TextBlock x:Name="tbTip"
                           FontSize="12"
                           Foreground="#1E5FD0"
                           FontFamily="Microsoft YaHei UI"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E1E1E1"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="panelItems" Margin="12"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbCount"
                       Grid.Column="0"
                       FontSize="12"
                       Foreground="#808080"
                       FontFamily="Microsoft YaHei UI"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="关闭"
                    Style="{StaticResource PclButton}"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>