<UserControl x:Class="CMW.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerSmallBtn" TargetType="Button" BasedOn="{StaticResource PclButtonDanger}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0"
                                                        CornerRadius="5"
                                                        Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="每周汇报"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#202020" FontFamily="Microsoft YaHei UI"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="生成本周报告"
                        Style="{StaticResource PclButtonPrimary}"
                        Margin="0,0,10,0"
                        Click="BtnGenerateThisWeek_Click"/>
                <Button Content="打开报告目录"
                        Style="{StaticResource PclButton}"
                        Click="BtnOpenFolder_Click"/>
            </StackPanel>
        </Grid>

        <!-- 左右两栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：报告列表 -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="历史报告" Style="{StaticResource TitleText}"/>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                            </ScrollViewer.Resources>

                            <ItemsControl x:Name="icReports">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                BorderBrush="#F0F0F0"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding WeekKey}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1E5FD0"
                                                               FontFamily="Microsoft YaHei UI"/>
                                                    <TextBlock Text="{Binding RangeText}"
                                                               FontSize="12"
                                                               Foreground="#606060"
                                                               FontFamily="Microsoft YaHei UI"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SummaryText}"
                                                               FontSize="11"
                                                               Foreground="#A0A0A0"
                                                               FontFamily="Microsoft YaHei UI"
                                                               Margin="0,2,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Vertical"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="查看"
                                                            Style="{StaticResource SmallBtn}"
                                                            Margin="0,0,0,4"
                                                            Click="BtnView_Click"
                                                            Tag="{Binding}"/>
                                                    <Button Content="删除"
                                                            Style="{StaticResource DangerSmallBtn}"
                                                            Click="BtnDelete_Click"
                                                            Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="tbEmpty"
                                   Text="暂无周报&#x0a;点右上角「生成本周报告」"
                                   FontSize="13"
                                   Foreground="#A0A0A0"
                                   FontFamily="Microsoft YaHei UI"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：预览 -->
            <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="tbPreviewTitle"
                                   Text="报告预览"
                                   Style="{StaticResource TitleText}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnExportText"
                                    Content="导出为文本"
                                    Style="{StaticResource SmallBtn}"
                                    Margin="0,0,8,0"
                                    Click="BtnExportText_Click"/>
                            <Button x:Name="btnExportMd"
                                    Content="导出为 Markdown"
                                    Style="{StaticResource SmallBtn}"
                                    Click="BtnExportMd_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FAFAFA"
                            BorderBrush="#E1E1E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                            </ScrollViewer.Resources>
                            <TextBlock x:Name="tbPreview"
                                       Text="（从左侧列表选择一份报告查看）"
                                       FontFamily="Consolas, Microsoft YaHei UI"
                                       FontSize="12"
                                       Foreground="#404040"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>