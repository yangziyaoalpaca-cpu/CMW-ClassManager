<Window x:Class="CMW.NoteAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增笔记"
        Width="600" Height="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ThemeTitleBarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="新增笔记"
                           Foreground="{DynamicResource ThemeTitleBarTextBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>

                <Button Grid.Column="1"
                        Content="✕"
                        Click="BtnClose_Click"
                        Foreground="{DynamicResource ThemeTitleBarTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        FontSize="13"
                        Cursor="Hand"
                        Width="44"
                        Height="32"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ThemeRowAltBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource GlobalCornerRadius}"
                    Padding="8"
                    MinHeight="240"
                    MaxHeight="320">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"/>

                    <TextBlock x:Name="EmptyHint"
                               Text="（无截图）"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextHintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="文字备注（可空）"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBox Grid.Row="1"
                         x:Name="txtContent"
                         Style="{StaticResource MultilineTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Height="100"
                         FontSize="13"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tbTip"
                           Grid.Column="0"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemePrimaryBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="取消"
                        Style="{StaticResource PclButton}"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="2"
                        Content="仅保存图"
                        Style="{StaticResource PclButton}"
                        Margin="0,0,8,0"
                        Click="BtnSaveImageOnly_Click"/>

                <Button Grid.Column="3"
                        Content="保存"
                        Style="{StaticResource PclButtonPrimary}"
                        Click="BtnSave_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>