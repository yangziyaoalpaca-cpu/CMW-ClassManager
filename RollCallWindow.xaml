<local:ReleasableWindow x:Class="CMW.RollCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CMW"
        Title="点名"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <local:ReleasableWindow.Resources>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudentToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource GlobalCornerRadius}"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Tick"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        Background="#E0E0E0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TickText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Lbl"
                                           Text="{TemplateBinding Content}"
                                           Margin="10,0,0,0"
                                           FontSize="13"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter TargetName="Tick" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter TargetName="TickText" Property="Text" Value="✓"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </local:ReleasableWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="tbTitle"
                       Text="点名"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>
            <TextBlock x:Name="tbSubtitle"
                       Text=""
                       FontSize="12" Foreground="{DynamicResource ThemeTextHintBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource GlobalCornerRadius}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tbCount"
                           Grid.Column="0"
                           Text="已交 0 / 0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemePrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="全选" Style="{StaticResource SmallBtn}" Click="BtnSelectAll_Click"/>
                    <Button Content="全不选" Style="{StaticResource SmallBtn}" Click="BtnSelectNone_Click"/>
                    <Button Content="反选" Style="{StaticResource SmallBtn}" Click="BtnInvert_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource GlobalCornerRadius}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="icStudents" Margin="12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource StudentToggle}"
                                      Content="{Binding DisplayText}"
                                      Margin="4"
                                      IsChecked="{Binding IsSubmitted, Mode=TwoWay}"
                                      Checked="Student_Checked"
                                      Unchecked="Student_Unchecked"
                                      Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="导出未交名单"
                    Style="{StaticResource SmallBtn}"
                    Click="BtnExportUnsigned_Click"/>

            <TextBlock x:Name="tbTip"
                       Grid.Column="1"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource ThemePrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>

            <Button Grid.Column="2"
                    Content="取消"
                    Style="{StaticResource PclButton}"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="3"
                    Content="确定"
                    Style="{StaticResource PclButtonPrimary}"
                    Click="BtnOk_Click"/>
        </Grid>
    </Grid>
</local:ReleasableWindow>