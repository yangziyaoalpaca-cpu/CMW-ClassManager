<UserControl x:Class="CMW.SeatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="座位表"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#202020" FontFamily="Microsoft YaHei UI"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnClearAll" Content="清空全部座位"
                        Style="{StaticResource PclButton}"
                        Margin="0,0,10,0"
                        Click="BtnClearAll_Click"/>
                <Button x:Name="btnSave" Content="保存"
                        Style="{StaticResource PclButtonPrimary}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>

        <!-- 方案栏 -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="方案："
                           Style="{StaticResource NormalText}"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="cbLayout" Grid.Column="1"
                          Margin="8,0,12,0"
                          MinWidth="180"
                          SelectionChanged="CbLayout_SelectionChanged"/>

                <TextBlock Grid.Column="2" Text="行："
                           Style="{StaticResource NormalText}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtRows" Grid.Column="3"
                         Width="50" Margin="6,0,12,0"
                         Text="6"
                         TextAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="列："
                           Style="{StaticResource NormalText}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="txtCols" Grid.Column="5"
                         Width="50" Margin="6,0,12,0"
                         Text="8"
                         TextAlignment="Center"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button Content="应用行列"
                            Style="{StaticResource PclButton}"
                            Margin="0,0,8,0"
                            Click="BtnApplySize_Click"/>
                    <Button Content="新建方案"
                            Style="{StaticResource PclButton}"
                            Margin="0,0,8,0"
                            Click="BtnNewLayout_Click"/>
                    <Button Content="删除方案"
                            Style="{StaticResource PclButtonDanger}"
                            Click="BtnDeleteLayout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 座位网格 -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>

                <!-- 讲台 -->
                <StackPanel>
                    <Border Background="#F5F5F5"
                            BorderBrush="#D8DCE0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16,8"
                            HorizontalAlignment="Center"
                            MinWidth="200"
                            Margin="0,0,0,20">
                        <TextBlock Text="讲  台"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#404040"
                                   FontFamily="Microsoft YaHei UI"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- 动态网格 -->
                    <Grid x:Name="gridSeats" HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 提示 -->
        <TextBlock Grid.Row="3"
                   x:Name="tbTip"
                   Style="{StaticResource HintText}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>