<Page x:Class="CMW.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="{DynamicResource GlobalFontFamily}">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeShadowLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource GlobalCornerRadius}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- ★ B3：渐变背景层（在图片下层，按预设切换显示） -->
        <Border x:Name="BgGradient" Visibility="Collapsed"/>

        <Image x:Name="BgImage"
               Source="Assets/Background.jpg"
               Stretch="UniformToFill"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="240" Height="240" CornerRadius="120" Background="#E5E7EB"
                    BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                <Image x:Name="SchoolLogo" Source="Assets/logo.png" Stretch="Uniform"/>
            </Border>

            <Border Width="320"
                    Height="56"
                    Margin="0,40,0,0"
                    Background="{DynamicResource ThemeCardBrush}"
                    BorderBrush="{DynamicResource ThemeShadowLineBrush}"
                    BorderThickness="0,0,1,1"
                    CornerRadius="{DynamicResource GlobalCornerRadius}">
                <TextBox x:Name="ClassNameTextBox"
                         Width="320"
                         Height="56"
                         FontSize="20"
                         HorizontalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         TextChanged="ClassNameTextBox_TextChanged"/>
            </Border>

            <!-- ★ C3：多条考试倒计时（前 3 条） -->
            <ItemsControl x:Name="icExamCountdowns"
                          Margin="0,20,0,0"
                          Visibility="Collapsed">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="20,12"
                                CornerRadius="{DynamicResource GlobalCornerRadius}"
                                Background="{DynamicResource ThemeCardBrush}"
                                BorderBrush="{DynamicResource ThemeShadowLineBrush}"
                                BorderThickness="0,0,1,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" 还有 "
                                           FontSize="14"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DaysLeft}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ThemePrimaryBrush}"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" 天"
                                           FontSize="14"
                                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                           FontFamily="{DynamicResource GlobalFontFamily}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,28">

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Homework">
                <StackPanel>
                    <TextBlock Text="今日作业" Style="{StaticResource StatLabel}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             MaxWidth="160" MaxHeight="34"
                             HorizontalAlignment="Center">
                        <TextBlock x:Name="tbStatHomework" Text="0" Style="{StaticResource StatValue}"/>
                    </Viewbox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Todo">
                <StackPanel>
                    <TextBlock Text="今日待办" Style="{StaticResource StatLabel}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             MaxWidth="160" MaxHeight="34"
                             HorizontalAlignment="Center">
                        <TextBlock x:Name="tbStatTodo" Text="0" Style="{StaticResource StatValue}"/>
                    </Viewbox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Duty">
                <StackPanel>
                    <TextBlock Text="今日值日" Style="{StaticResource StatLabel}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             MaxWidth="160" MaxHeight="28"
                             HorizontalAlignment="Center">
                        <TextBlock x:Name="tbStatDuty" Text="未安排"
                                   Style="{StaticResource StatValue}"
                                   FontSize="16"
                                   Margin="0,8,0,0"/>
                    </Viewbox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="NextClass">
                <StackPanel>
                    <TextBlock Text="下节课" Style="{StaticResource StatLabel}"/>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                             MaxWidth="160" MaxHeight="28"
                             HorizontalAlignment="Center">
                        <TextBlock x:Name="tbStatNextClass" Text="--"
                                   Style="{StaticResource StatValue}"
                                   FontSize="16"
                                   Margin="0,8,0,0"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>