<Page x:Class="CMW.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#A8B5C5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6E6E6E"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E5FD0"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Image x:Name="BgImage"
               Source="Assets/Background.jpg"
               Stretch="UniformToFill"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="240" Height="240" CornerRadius="120" Background="#E5E7EB"
                    BorderBrush="#A8B5C5" BorderThickness="1">
                <Image x:Name="SchoolLogo" Source="Assets/logo.png" Stretch="Uniform"/>
            </Border>

            <Border Width="320"
                    Height="56"
                    Margin="0,40,0,0"
                    Background="#FFFFFF"
                    BorderBrush="#A8B5C5"
                    BorderThickness="1.5"
                    CornerRadius="8">
                <TextBox x:Name="ClassNameTextBox"
                         Width="320"
                         Height="56"
                         FontSize="20"
                         HorizontalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         TextChanged="ClassNameTextBox_TextChanged"/>
            </Border>

            <Border x:Name="ExamCountdownCard"
                    Margin="0,20,0,0"
                    Padding="20,12"
                    CornerRadius="10"
                    Background="#FFFFFF"
                    BorderBrush="#A8B5C5"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="tbExamName"
                               FontSize="14"
                               Foreground="#606060"
                               FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" 还有 "
                               FontSize="14"
                               Foreground="#606060"
                               FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="tbExamDays"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1E5FD0"
                               FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" 天"
                               FontSize="14"
                               Foreground="#606060"
                               FontFamily="Microsoft YaHei UI"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,28">

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Homework">
                <StackPanel>
                    <TextBlock Text="今日作业" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="tbStatHomework" Text="0" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Todo">
                <StackPanel>
                    <TextBlock Text="今日待办" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="tbStatTodo" Text="0" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="Duty">
                <StackPanel>
                    <TextBlock Text="今日值日" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="tbStatDuty" Text="未安排"
                               Style="{StaticResource StatValue}"
                               FontSize="16"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCard}" Cursor="Hand"
                    MouseLeftButtonUp="StatCard_MouseLeftButtonUp"
                    Tag="NextClass">
                <StackPanel>
                    <TextBlock Text="下节课" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="tbStatNextClass" Text="--"
                               Style="{StaticResource StatValue}"
                               FontSize="16"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>