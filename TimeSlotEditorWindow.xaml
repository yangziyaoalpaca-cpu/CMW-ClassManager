<Window x:Class="CMW.TimeSlotEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑时间段"
        Width="660" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>

        <Style x:Key="IosToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="#CCCCCC">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource GlobalCornerRadius}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="时间段编辑"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>
            <TextBlock Text="用于灵动岛上下课提醒与右侧窗口自动弹出；每行一个时间段，保存后自动按开始时间排序。勾选「长时段」表示该时段右侧窗口弹出后不自动收回（如早读 / 大课间 / 晚自习）。"
                       FontSize="12" Foreground="{DynamicResource ThemeTextHintBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource HeaderRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="名称"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
                <TextBlock Grid.Column="1" Text="开始时间"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
                <TextBlock Grid.Column="2" Text="结束时间"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
                <TextBlock Grid.Column="3" Text="提醒"
                           FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
                <TextBlock Grid.Column="4" Text="长时段"
                           FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
                <TextBlock Grid.Column="5" Text="操作"
                           FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="slotListPanel"/>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="+ 添加时段"
                    Style="{StaticResource PclButton}"
                    Click="BtnAddSlot_Click"/>

            <TextBlock x:Name="tbTip"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeDangerBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>

            <Button Grid.Column="2"
                    Content="取消"
                    Style="{StaticResource PclButton}"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="3"
                    Content="保存"
                    Style="{StaticResource PclButtonPrimary}"
                    Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>