<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主题色 · ClassIsland 风（深色） -->
    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="#5B7CFF"/>
    <SolidColorBrush x:Key="ThemePrimaryHoverBrush" Color="#6B8CFF"/>
    <SolidColorBrush x:Key="ThemePrimaryPressedBrush" Color="#4A6BE0"/>
    <SolidColorBrush x:Key="ThemePrimaryLightBrush" Color="#7A96FF"/>
    <SolidColorBrush x:Key="ThemePrimaryBgBrush" Color="#2A2F42"/>
    <SolidColorBrush x:Key="ThemePrimaryBgHoverBrush" Color="#353B52"/>

    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ThemeCardBrush" Color="#242424"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ThemeBorderLightBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="ThemeRowAltBrush" Color="#2E2E2E"/>

    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="ThemeTextHintBrush" Color="#808080"/>

    <SolidColorBrush x:Key="ThemeTitleBarBrush" Color="#151515"/>
    <SolidColorBrush x:Key="ThemeTitleBarTextBrush" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="ThemeDangerBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="ThemeDangerHoverBrush" Color="#FF5050"/>

    <SolidColorBrush x:Key="ThemeInputBgBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#3A3A3A"/>

    <!-- ★ 33.0.0：深色主题阴影线用亮色高光 -->
    <SolidColorBrush x:Key="ThemeShadowLineBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ThemeShadowLineLightBrush" Color="#0FFFFFFF"/>

    <SolidColorBrush x:Key="ThemeNavActiveBgBrush" Color="#2A2F42"/>
    <SolidColorBrush x:Key="ThemeNavHoverBgBrush" Color="#252A3A"/>

    <SolidColorBrush x:Key="ThemeTabAccentBrush" Color="#5B7CFF"/>

    <SolidColorBrush x:Key="ThemeIconForegroundBrush" Color="#7A96FF"/>

    <SolidColorBrush x:Key="PclPrimaryBrush" Color="#5B7CFF"/>
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#1A1A1A"/>

</ResourceDictionary>