<Window x:Class="CMW.NotesViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课上笔记"
        Width="1000" Height="660"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E8EBF0">

    <Window.Resources>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerSmallBtn" TargetType="Button" BasedOn="{StaticResource PclButtonDanger}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="课上笔记"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#202020"
                       FontFamily="Microsoft YaHei UI"/>
            <TextBlock x:Name="tbSubtitle"
                       Text="截图笔记与文字笔记列表"
                       FontSize="12" Foreground="#808080"
                       FontFamily="Microsoft YaHei UI"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 主体：左列表 + 右预览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：笔记列表 -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E1E1E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,12,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                        </ScrollViewer.Resources>

                        <ItemsControl x:Name="icNotes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBg"
                                            Background="Transparent"
                                            BorderBrush="#F0F0F0"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="NoteRow_MouseLeftButtonUp"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 缩略图 -->
                                            <Border Grid.Column="0"
                                                    Width="72" Height="52"
                                                    Background="#F5F5F5"
                                                    BorderBrush="#E1E1E1"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Image Source="{Binding ThumbSource}"
                                                           Stretch="Uniform"
                                                           SnapsToDevicePixels="True"/>
                                                    <TextBlock Text="无图"
                                                               FontSize="11"
                                                               Foreground="#A0A0A0"
                                                               FontFamily="Microsoft YaHei UI"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding NoImageVisibility}"/>
                                                </Grid>
                                            </Border>

                                            <!-- 文字 -->
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayText}"
                                                           FontFamily="Microsoft YaHei UI"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#202020"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CreatedText}"
                                                           FontFamily="Microsoft YaHei UI"
                                                           FontSize="11"
                                                           Foreground="#808080"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E8F0FE"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="tbEmpty"
                               Text="暂无笔记&#x0a;在灵动岛「笔记」页新增"
                               FontSize="13"
                               Foreground="#A0A0A0"
                               FontFamily="Microsoft YaHei UI"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 右：预览 -->
            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="#E1E1E1"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="tbPreviewTitle"
                               Grid.Row="0"
                               Text="选择左侧笔记查看详情"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#202020"
                               Margin="16,14,16,8"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,0,16,16">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                        </ScrollViewer.Resources>

                        <StackPanel>
                            <!-- 大图 -->
                            <Border x:Name="ImageCard"
                                    Background="#FAFAFA"
                                    BorderBrush="#E1E1E1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    MinHeight="200"
                                    Visibility="Collapsed">
                                <Image x:Name="PreviewImage"
                                       Stretch="Uniform"
                                       MaxHeight="480"
                                       SnapsToDevicePixels="True"/>
                            </Border>

                            <!-- 文字 -->
                            <Border x:Name="TextCard"
                                    Background="#FAFAFA"
                                    BorderBrush="#E1E1E1"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="PreviewText"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="13"
                                           Foreground="#202020"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock x:Name="tbNoContent"
                                       Text="（这条笔记没有内容）"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="13"
                                       Foreground="#A0A0A0"
                                       Margin="0,20,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="删除当前笔记"
                    Style="{StaticResource DangerSmallBtn}"
                    Margin="0,0,10,0"
                    Click="BtnDeleteCurrent_Click"/>

            <Button Grid.Column="1"
                    Content="打开图片目录"
                    Style="{StaticResource SmallBtn}"
                    Click="BtnOpenFolder_Click"/>

            <TextBlock x:Name="tbTip"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0"
                       Style="{StaticResource HintText}"/>

            <Button Grid.Column="3"
                    Content="关闭"
                    Style="{StaticResource PclButton}"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>