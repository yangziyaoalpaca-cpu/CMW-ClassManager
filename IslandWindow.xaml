<Window x:Class="CMW.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource GlobalFontFamily}"
        MinWidth="0" MinHeight="0"
        Width="400" Height="260"
        SizeToContent="Manual">

    <Window.Resources>

        <Style x:Key="CardTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandMenuButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">

        <StackPanel x:Name="ContentRow"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">

            <!-- 主胶囊 / 圆形 / 卡片 -->
            <Border x:Name="MainBorder"
                    Width="60"
                    Height="18"
                    CornerRadius="9"
                    Background="#F21A1A1A"
                    VerticalAlignment="Top"
                    ClipToBounds="True"
                    MouseLeftButtonUp="MainBorder_MouseLeftButtonUp"
                    MouseRightButtonUp="MainBorder_MouseRightButtonUp"
                    MouseEnter="MainBorder_MouseEnter"
                    MouseLeave="MainBorder_MouseLeave"
                    MouseLeftButtonDown="MainBorder_MouseLeftButtonDown"
                    TouchDown="MainBorder_TouchDown"
                    TouchMove="MainBorder_TouchMove"
                    TouchUp="MainBorder_TouchUp">
                <Grid>
                    <TextBlock x:Name="CapsuleLabel"
                               Text="CMW"
                               Foreground="White"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Grid x:Name="CardContent" Opacity="0" IsHitTestVisible="False" Margin="20,16,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ★ B2：图标 + 标题 -->
                        <StackPanel x:Name="CardTitleBar"
                                    Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Image x:Name="CardIcon"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="CardTitle"
                                       Text="CMW 菜单"
                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="CardTabs"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,12">
                            <RadioButton x:Name="CardTabInfo" Style="{StaticResource CardTab}" Content="菜单" GroupName="CardTab" IsChecked="True" Checked="CardTab_Checked"/>
                            <RadioButton x:Name="CardTabHomework" Style="{StaticResource CardTab}" Content="作业" GroupName="CardTab" Margin="4,0,0,0" Checked="CardTab_Checked"/>
                            <RadioButton x:Name="CardTabTodo" Style="{StaticResource CardTab}" Content="待办" GroupName="CardTab" Margin="4,0,0,0" Checked="CardTab_Checked"/>
                            <RadioButton x:Name="CardTabSchedule" Style="{StaticResource CardTab}" Content="课表" GroupName="CardTab" Margin="4,0,0,0" Checked="CardTab_Checked"/>
                            <RadioButton x:Name="CardTabNotes" Style="{StaticResource CardTab}" Content="笔记" GroupName="CardTab" Margin="4,0,0,0" Checked="CardTab_Checked"/>
                            <RadioButton x:Name="CardTabTimer" Style="{StaticResource CardTab}" Content="计时" GroupName="CardTab" Margin="4,0,0,0" Checked="CardTab_Checked"/>
                        </StackPanel>

                        <Grid Grid.Row="2">

                            <StackPanel x:Name="PanelInfo" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,10,0">
                                <Button x:Name="MenuOpenMainBtn" Style="{StaticResource IslandMenuButton}" Content="🏠  打开主窗口" Click="MenuOpenMainBtn_Click"/>
                                <Button x:Name="MenuShowRightPanelBtn" Style="{StaticResource IslandMenuButton}" Content="📌  显示右侧窗口" Click="MenuShowRightPanel_Click"/>
                                <Button x:Name="MenuShowLeftScheduleBtn" Style="{StaticResource IslandMenuButton}" Content="📋  显示 / 隐藏横条" Click="MenuShowLeftSchedule_Click"/>
                                <Button x:Name="MenuExitBtn" Style="{StaticResource IslandMenuButton}" Content="❌  退出程序" Foreground="#FF8080" Click="MenuExitBtn_Click"/>
                            </StackPanel>

                            <StackPanel x:Name="PanelNotify" Visibility="Collapsed" Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,10,0" MouseLeftButtonUp="PanelNotify_MouseLeftButtonUp">
                                <TextBlock x:Name="NotifyContentText" Text="" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="16" Foreground="#EEEEEE" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="NotifyTapHint" Text="" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="11" Foreground="#66FFFFFF" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <ScrollViewer x:Name="PanelHomework" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl x:Name="icCardHomework">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="CardHomework_Checked" Unchecked="CardHomework_Unchecked" Tag="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="{Binding TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="tbCardHomeworkEmpty" Text="今日无未完成作业" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#88EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </ScrollViewer>

                            <ScrollViewer x:Name="PanelTodo" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl x:Name="icCardTodo">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" Checked="CardTodo_Checked" Unchecked="CardTodo_Unchecked" Tag="{Binding}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#EEEEEE" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="tbCardTodoEmpty" Text="今日无未完成待办" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#88EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </ScrollViewer>

                            <ScrollViewer x:Name="PanelSchedule" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <ItemsControl x:Name="icCardSchedule">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#EEEEEE" TextWrapping="Wrap" Margin="0,3"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="tbCardScheduleEmpty" Text="今日无课程" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#88EEEEEE" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </ScrollViewer>

                            <Grid x:Name="PanelNotes" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="BtnAddNote" Grid.Row="0" Content="📷  新增笔记（截图）" Click="BtnAddNote_Click" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Padding="10,6" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="12" Cursor="Hand" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <ItemsControl x:Name="icCardNotes">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1FFFFFFF" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding DisplayText}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="13" Foreground="#EEEEEE" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding CreatedText}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="10" Foreground="#88EEEEEE" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="✕" Click="DeleteNote_Click" Tag="{Binding}" Background="Transparent" Foreground="#FF8080" BorderThickness="0" FontSize="12" Padding="6,2" Cursor="Hand" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="tbCardNotesEmpty" Text="暂无笔记&#x0a;点上方按钮截图记录" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="12" Foreground="#88EEEEEE" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <ScrollViewer x:Name="PanelRollCall" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RollCallItemsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="CardHintText" Text="" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="11" Foreground="#80CCEEEE" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 横条 -->
            <Border x:Name="BarBorder"
                    Width="0"
                    Height="40"
                    Visibility="Collapsed"
                    Opacity="0"
                    Margin="6,0,0,0"
                    VerticalAlignment="Top"
                    CornerRadius="20"
                    Background="#E61A1A1A"
                    ClipToBounds="True"
                    MouseLeftButtonUp="BarBorder_MouseLeftButtonUp"
                    MouseRightButtonUp="BarBorder_MouseRightButtonUp">
                <Grid Margin="20,0,20,0">

                    <!-- 组 1 · 日期 -->
                    <StackPanel x:Name="BarPanelDate" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="BarTxtDate" Foreground="White" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  " FontSize="14"/>
                        <TextBlock x:Name="BarTxtWeekday" Foreground="#B0FFFFFF" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 组 2 · 课表 -->
                    <ItemsControl x:Name="BarIcSchedule" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" CornerRadius="6" Padding="6,4" Margin="2,0">
                                    <TextBlock Text="{Binding ShortName}" Foreground="{Binding Fg}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{Binding FontSize}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 组 3 · 状态 -->
                    <StackPanel x:Name="BarPanelStatus" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="BarTxtStatus" Foreground="White" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BarTxtDot1" Text="  ·  " Foreground="#66FFFFFF" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BarTxtCountdown" Foreground="#FFB366" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BarTxtDot2" Text="  ·  " Foreground="#66FFFFFF" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BarTxtNext" Foreground="#CCEEEEEE" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ★ 组 4 · 作业 -->
                    <ItemsControl x:Name="BarIcHomework" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Fg}" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{Binding FontSize}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BarTxtHomeworkEmpty"
                               Text="今日无作业"
                               Foreground="#88FFFFFF"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- ★ 组 5 · 值日 -->
                    <TextBlock x:Name="BarTxtDuty"
                               Visibility="Collapsed"
                               Foreground="White"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- ★ 组 6 · 待办 -->
                    <ItemsControl x:Name="BarIcTodo" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="{Binding Text}" Foreground="#EEEEEE" FontFamily="{DynamicResource GlobalFontFamily}" FontSize="{Binding FontSize}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BarTxtTodoEmpty"
                               Text="今日无待办"
                               Foreground="#88FFFFFF"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>