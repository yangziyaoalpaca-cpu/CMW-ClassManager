<UserControl x:Class="CMW.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <UserControl.Resources>

        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="IosToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="#CCCCCC">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0"
                                                        CornerRadius="5"
                                                        Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="软件设置"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   FontFamily="{DynamicResource GlobalFontFamily}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabBasic" Style="{StaticResource SubTabButton}"
                             Content="基础设置" GroupName="SettingsTab"
                             Tag="M10 2 L14 2 L14 6 L10 6 Z M10 18 L14 18 L14 22 L10 22 Z M2 10 L6 10 L6 14 L2 14 Z M18 10 L22 10 L22 14 L18 14 Z M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabBackground" Style="{StaticResource SubTabButton}"
                             Content="主页背景" GroupName="SettingsTab"
                             Tag="M3 5 L21 5 L21 19 L3 19 Z M3 15 L9 10 L13 14 L17 11 L21 15"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabIsland" Style="{StaticResource SubTabButton}"
                             Content="灵动岛" GroupName="SettingsTab"
                             Tag="M6 8 L18 8 A4 4 0 0 1 18 16 L6 16 A4 4 0 0 1 6 8 Z"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabFloat" Style="{StaticResource SubTabButton}"
                             Content="右侧窗口" GroupName="SettingsTab"
                             Tag="M3 5 L21 5 L21 19 L3 19 Z M3 9 L21 9"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabTeaching" Style="{StaticResource SubTabButton}"
                             Content="教学辅助" GroupName="SettingsTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabStartup" Style="{StaticResource SubTabButton}"
                             Content="启动设置" GroupName="SettingsTab"
                             Tag="M12 3 L12 12 M6 7 A8 8 0 1 0 18 7"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabData" Style="{StaticResource SubTabButton}"
                             Content="数据管理" GroupName="SettingsTab"
                             Tag="M4 6 A8 3 0 0 0 20 6 L20 18 A8 3 0 0 1 4 18 Z M4 12 A8 3 0 0 0 20 12"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabAbout" Style="{StaticResource SubTabButton}"
                             Content="关于" GroupName="SettingsTab"
                             Tag="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 8 L12 9 M12 11 L12 17"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>
                        <!-- 基础设置 -->
                        <StackPanel x:Name="PanelBasic">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="基础设置" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="班级名称" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtClassName" Margin="0,0,0,12"/>

                                    <TextBlock Text="主题" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbTheme" Margin="0,0,0,4"/>
                                    <TextBlock Text="切换后立即生效" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <TextBlock Text="背景高斯模糊强度" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderBlur" Minimum="0" Maximum="80" Value="40" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="tbBlurValue" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                    <TextBlock Text="保存后生效；启用开关在「主页背景」中调整"
                                               Style="{StaticResource HintText}" Margin="0,0,0,12"/>

                                    <TextBlock Text="字体" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbFontFamily" Margin="0,0,0,4"/>
                                    <TextBlock Text="切换后立即生效" Style="{StaticResource HintText}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="字体自动缩放" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="文字超出容器时自动缩小字号，避免显示不全"
                                                       Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleFontAutoFit" Grid.Column="1"
                                                  Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 多条考试倒计时 -->
                                    <TextBlock Text="考试倒计时（可添加多条）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBlock Text="首页与电子班牌显示最近的前 3 条；留空则不显示"
                                               Style="{StaticResource HintText}" Margin="0,0,0,8"/>

                                    <ItemsControl x:Name="icExamCountdowns" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeRowAltBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="12,8"
                                                        Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource NormalText}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Date}"
                                                                       Style="{StaticResource HintText}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,12,0"
                                                                   FontFamily="{DynamicResource GlobalFontFamily}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemePrimaryBrush}"
                                                                   Text="{Binding DaysLeft, StringFormat=还有 {0} 天}"/>
                                                        <Button Grid.Column="2"
                                                                Content="删除"
                                                                Style="{StaticResource PclButtonDanger}"
                                                                Padding="10,2"
                                                                FontSize="12"
                                                                VerticalAlignment="Center"
                                                                Click="BtnDeleteExamCountdown_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNewExamName" Grid.Column="0"
                                                 ToolTip="考试名称，如：高考" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text=" 日期 "
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource NormalText}"/>
                                        <DatePicker x:Name="dpNewExamDate" Grid.Column="2"
                                                    Margin="8,0,8,0"/>
                                        <Button x:Name="btnAddExamCountdown" Grid.Column="3"
                                                Content="添加"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Click="BtnAddExamCountdown_Click"/>
                                    </Grid>

                                    <TextBlock Text="（修改已有条目可直接在列表中删除后重加）"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="值日组自动轮换" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="每日首次启动时自动切到下一组"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleDutyAutoRotate"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 上下课表现方式 -->
                                    <TextBlock Text="上下课表现方式" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbClassChangeStyle" Margin="0,0,0,4">
                                        <ComboBoxItem Content="变色 → 通知（推荐）" Tag="ColorThenNotify" IsSelected="True"/>
                                        <ComboBoxItem Content="仅通知" Tag="NotifyOnly"/>
                                        <ComboBoxItem Content="仅变色 + 横条" Tag="ColorAndBar"/>
                                        <ComboBoxItem Content="都不做" Tag="None"/>
                                    </ComboBox>
                                    <TextBlock Text="变色时长请到「灵动岛」页调整；「仅变色 + 横条」不含通知"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 主页背景 -->
                        <StackPanel x:Name="PanelBackground" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="主页背景" Style="{StaticResource TitleText}"/>

                                    <TextBlock Text="背景样式" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbBackgroundPreset" Margin="0,0,0,4">
                                        <ComboBoxItem Content="图片（默认）" Tag="None" IsSelected="True"/>
                                        <ComboBoxItem Content="深蓝斜向" Tag="DeepBlue"/>
                                        <ComboBoxItem Content="晨雾浅蓝" Tag="MorningMist"/>
                                        <ComboBoxItem Content="暗夜紫灰" Tag="NightPurple"/>
                                        <ComboBoxItem Content="墨绿山水" Tag="InkGreen"/>
                                    </ComboBox>
                                    <TextBlock Text="选渐变时不再使用图片；选图片时使用下方配置的图片"
                                               Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用背景模糊（仅图片模式生效）" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="关闭后显示原图（无模糊）"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBlurEnabled"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="当前背景" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtBackgroundPath" IsReadOnly="True" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnChooseBackground" Content="选择图片"
                                                Style="{StaticResource PclButton}"
                                                Margin="0,0,12,0" Click="BtnChooseBackground_Click"/>
                                        <Button x:Name="btnResetBackground" Content="恢复默认"
                                                Style="{StaticResource PclButton}"
                                                Click="BtnResetBackground_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="支持 JPG / PNG / BMP，建议 1920×1080"
                                               Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 灵动岛 -->
                        <StackPanel x:Name="PanelIsland" Visibility="Collapsed">

                            <!-- 胶囊基础 -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="胶囊设置" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="允许拖动灵动岛" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="关闭时固定在屏幕顶部中央" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleIslandDraggable" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="通知条宽度（屏幕百分比）" Style="{StaticResource NormalText}" Margin="0,10,0,4"/>
                                    <Slider x:Name="sliderNotifyWidth"
                                            Minimum="50" Maximum="100"
                                            Value="96"
                                            TickFrequency="2"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbNotifyWidth" Style="{StaticResource HintText}" Margin="0,0,0,12"/>

                                    <TextBlock Text="通知条高度（屏幕百分比）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderNotifyHeight"
                                            Minimum="5" Maximum="30"
                                            Value="10"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbNotifyHeight" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <TextBlock Text="灵动岛展开大小" Style="{StaticResource NormalText}" Margin="0,6,0,4"/>
                                    <ComboBox x:Name="cbIslandSize" Margin="0,0,0,10">
                                        <ComboBoxItem Content="小（400 × 260）" Tag="Small"/>
                                        <ComboBoxItem Content="中（480 × 320）· 推荐" Tag="Medium"/>
                                        <ComboBoxItem Content="大（560 × 360）" Tag="Large"/>
                                        <ComboBoxItem Content="超大（640 × 420）" Tag="XLarge"/>
                                    </ComboBox>

                                    <TextBlock Text="胶囊显示内容" Style="{StaticResource NormalText}" Margin="0,6,0,4"/>
                                    <ComboBox x:Name="cbCapsuleTextMode" Margin="0,0,0,10">
                                        <ComboBoxItem Content="CMW（默认）" Tag="CMW"/>
                                        <ComboBoxItem Content="距下课 / 上课倒计时" Tag="Countdown"/>
                                        <ComboBoxItem Content="下节课名" Tag="NextClass"/>
                                        <ComboBoxItem Content="未完成作业数" Tag="HomeworkCount"/>
                                        <ComboBoxItem Content="智能切换" Tag="Auto"/>
                                    </ComboBox>

                                    <TextBlock Text="通知收回方式" Style="{StaticResource NormalText}" Margin="0,6,0,4"/>
                                    <ComboBox x:Name="cbNotifyMode" Margin="0,0,0,16">
                                        <ComboBoxItem Content="3 秒后自动收回" Tag="Auto"/>
                                        <ComboBoxItem Content="单击弹窗外区域收回" Tag="Manual"/>
                                    </ComboBox>

                                    <TextBlock Text="卡片字体倍率" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderIslandFontScale"
                                            Minimum="0.8" Maximum="1.5"
                                            Value="1.0"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbIslandFontScale"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,16"/>

                                    <TextBlock Text="点击展开后自动收回（秒）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderIslandAutoCollapse"
                                            Minimum="2" Maximum="60"
                                            Value="8"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbIslandAutoCollapse"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,16"/>

                                    <TextBlock Text="上课提醒静音时段（空 = 不启用）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtSilentStart" Grid.Column="0" ToolTip="例：22:00"/>
                                        <TextBlock Grid.Column="1" Text=" 到 " VerticalAlignment="Center" Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtSilentEnd" Grid.Column="2" ToolTip="例：06:00"/>
                                    </Grid>
                                    <TextBlock Text="此时段内不弹上下课提醒；待办 / 作业催收不受影响"
                                               Style="{StaticResource HintText}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 横条设置 -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="横条设置" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="横条从圆形胶囊后方延伸出来，展示日期 / 课表 / 状态 / 作业 / 值日 / 待办信息"
                                               Style="{StaticResource HintText}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用横条" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="关闭后，只剩胶囊" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBarEnabled" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="上下课自动延伸 / 缩回" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="下课时横条自动延伸，上课时自动缩回；仅在「上下课表现方式」= 仅变色 + 横条时生效"
                                                       Style="{StaticResource HintText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBarAutoExtend" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="允许右键手动切换" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="右键胶囊 / 横条可手动切换伸缩" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBarManualExtend" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="上下课时变蓝时长（秒）" Style="{StaticResource NormalText}" Margin="0,10,0,4"/>
                                    <Slider x:Name="sliderBlueFlash"
                                            Minimum="0" Maximum="10"
                                            Value="2"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbBlueFlash" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <TextBlock Text="横条宽度（像素，50 = 最窄）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderBarWidth"
                                            Minimum="50" Maximum="1920"
                                            Value="50"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbBarWidth" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="tbBarWidthActual" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <TextBlock Text="圆形直径（像素）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderCircleDiameter"
                                            Minimum="30" Maximum="150"
                                            Value="40"
                                            TickFrequency="2"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbCircleDiameter" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="自动轮播" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="横条内容在多个分组间自动切换" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBarAutoRotate" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="轮播间隔（秒）" Style="{StaticResource NormalText}" Margin="0,10,0,4"/>
                                    <Slider x:Name="sliderRotateSeconds"
                                            Minimum="3" Maximum="60"
                                            Value="8"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRotateSeconds" Style="{StaticResource HintText}" Margin="0,0,0,16"/>

                                    <TextBlock Text="显示分组" Style="{StaticResource NormalText}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="日期时间组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupDate" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="课表组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupSchedule" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="状态组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupStatus" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="作业组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupHomework" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="值日组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupDuty" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="待办组" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="toggleGroupTodo" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="显示顺序（按住 ≡ 拖动调整）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBlock Text="顺序只影响已启用分组的排列；被关闭的分组不会显示"
                                               Style="{StaticResource HintText}" Margin="0,0,0,8"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="4"
                                            Margin="0,0,0,16">
                                        <StackPanel x:Name="panelBarGroupOrder"/>
                                    </Border>

                                    <Button x:Name="btnEditSubjectMap"
                                            Content="编辑课程简称"
                                            Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left"
                                            Click="BtnEditSubjectMap_Click"/>
                                    <TextBlock Text="给课程名指定短名（如：数学 → 数），横条课程组使用"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 上下课提醒 -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="上下课提醒" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="上课提醒" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="每节课开始时弹出提醒" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleClassStartRemind" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下课提醒" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="每节课结束时弹出提醒" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleClassEndRemind" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="提醒样式" Style="{StaticResource NormalText}" Margin="0,6,0,4"/>
                                    <ComboBox x:Name="cbClassRemindStyle" Margin="0,0,0,10">
                                        <ComboBoxItem Content="弹窗（原样式）" Tag="Popup"/>
                                        <ComboBoxItem Content="灵动岛内小字" Tag="Mini"/>
                                        <ComboBoxItem Content="弹窗 + 小字" Tag="Both"/>
                                        <ComboBoxItem Content="都不显示" Tag="None"/>
                                    </ComboBox>

                                    <TextBlock Text="小字提醒持续秒数" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderMiniRemindDuration"
                                            Minimum="2" Maximum="30"
                                            Value="5"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbMiniRemindDuration"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>

                            <!-- 值日 / 待办 提醒 -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="值日 / 待办 提醒" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用值日提醒" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="到点弹出今日值日组信息，支持多个时间点" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleDutyRemind" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNewDutyTime" Grid.Column="0" ToolTip="HH:mm" KeyDown="TxtNewDutyTime_KeyDown"/>
                                        <Button x:Name="btnAddDutyTime" Grid.Column="2" Content="添加"
                                                Style="{StaticResource PclButton}" Click="BtnAddDutyTime_Click"/>
                                    </Grid>

                                    <ItemsControl x:Name="icDutyTimes" Margin="0,0,0,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeRowAltBrush}"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="12,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding}"
                                                                   Style="{StaticResource NormalText}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="删除"
                                                                Style="{StaticResource PclButtonDanger}"
                                                                Padding="10,2" FontSize="12"
                                                                Click="BtnDeleteDutyTime_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用待办每日提醒（独立）" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="支持多个时间点，两个都生效" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleTodoCustomRemind" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNewTodoTime" Grid.Column="0" ToolTip="HH:mm" KeyDown="TxtNewTodoTime_KeyDown"/>
                                        <Button x:Name="btnAddTodoTime" Grid.Column="2" Content="添加"
                                                Style="{StaticResource PclButton}" Click="BtnAddTodoTime_Click"/>
                                    </Grid>

                                    <ItemsControl x:Name="icTodoTimes" Margin="0,0,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeRowAltBrush}"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="12,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding}"
                                                                   Style="{StaticResource NormalText}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="删除"
                                                                Style="{StaticResource PclButtonDanger}"
                                                                Padding="10,2" FontSize="12"
                                                                Click="BtnDeleteTodoTime_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧窗口 -->
                        <StackPanel x:Name="PanelFloat" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="右侧智能窗口" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用右侧窗口" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="贴在屏幕右侧；上课自动收起，下课自动弹出"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleRightEnabled"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="上课自动收起" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="上课开始时，右侧窗口自动滑回"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleRightAutoHide"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="下课自动弹出" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="下课 / 长时段开始时，右侧窗口自动滑出"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleRightAutoShow"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="使用独立的时间段表" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="右侧窗口的弹出 / 收起按此表，与灵动岛上下课时间独立"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleRightOwnTimeSlots"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Button x:Name="btnEditRightTimeSlots"
                                            Content="编辑右侧独立时段表"
                                            Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,16"
                                            Click="BtnEditRightTimeSlots_Click"/>

                                    <TextBlock Text="窗口宽度（像素）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderRightWidth"
                                            Minimum="200" Maximum="600"
                                            Value="360"
                                            TickFrequency="20"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRightWidth"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="窗口高度（屏幕百分比）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderRightHeight"
                                            Minimum="30" Maximum="90"
                                            Value="70"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRightHeight"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="内容模式"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbRightContentMode" Margin="0,0,0,14">
                                        <ComboBoxItem Content="只显示作业" Tag="Homework"/>
                                        <ComboBoxItem Content="只显示值日" Tag="Duty"/>
                                        <ComboBoxItem Content="只显示待办" Tag="Todo"/>
                                        <ComboBoxItem Content="自动切换（3 项轮流）" Tag="Auto"/>
                                    </ComboBox>

                                    <TextBlock Text="自动切换间隔（秒）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderRightAutoSec"
                                            Minimum="5" Maximum="60"
                                            Value="15"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRightAutoSec"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="字体倍率"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderRightFontScale"
                                            Minimum="0.8" Maximum="1.5"
                                            Value="1.0"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRightFontScale"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="提示：可右键灵动岛 → 显示右侧窗口，手动弹出。手动关闭后下节课再自动弹出。值日页字体固定为大号，不受字体倍率影响。"
                                               Style="{StaticResource HintText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 教学辅助 -->
                        <StackPanel x:Name="PanelTeaching" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="电子班牌定时开关" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用班牌定时" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="到点自动开启 / 关闭电子班牌" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleBoardAutoSchedule"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="自动开启 " VerticalAlignment="Center" Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtBoardStartTime" Grid.Column="1" Margin="8,0,16,0" ToolTip="HH:mm"/>
                                        <TextBlock Grid.Column="2" Text="自动关闭 " VerticalAlignment="Center" Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtBoardEndTime" Grid.Column="3" Margin="8,0,0,0" ToolTip="HH:mm"/>
                                    </Grid>
                                    <TextBlock Text="注：开启后，到达开始时间自动全屏显示班牌；到达结束时间自动关闭"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 启动设置 -->
                        <StackPanel x:Name="PanelStartup" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="启动设置" Style="{StaticResource TitleText}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="开机自启动" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="开机后自动启动 CMW" Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleAutoStart" Grid.Column="1" Style="{StaticResource IosToggle}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="电脑开关机定时脚本" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用定时脚本" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="生成 Windows 任务计划程序脚本（.bat），可手动导入任务计划程序实现定时开机 / 关机"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="togglePowerSchedule"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="开机时间 " VerticalAlignment="Center" Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtPowerOnTime" Grid.Column="1" Margin="8,0,16,0" ToolTip="HH:mm"/>
                                        <TextBlock Grid.Column="2" Text="关机时间 " VerticalAlignment="Center" Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtPowerOffTime" Grid.Column="3" Margin="8,0,0,0" ToolTip="HH:mm"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnGeneratePowerScripts"
                                                Content="生成脚本"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Margin="0,0,12,0"
                                                Click="BtnGeneratePowerScripts_Click"/>
                                        <Button x:Name="btnOpenScriptsDir"
                                                Content="打开脚本目录"
                                                Style="{StaticResource PclButton}"
                                                Click="BtnOpenScriptsDir_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="脚本会生成在 Scripts/ 目录，包含 power_on.bat 和 power_off.bat。使用方式：打开「任务计划程序」→ 创建基本任务 → 触发时间选你设置的时刻 → 操作选「启动程序」→ 选对应 .bat"
                                               Style="{StaticResource HintText}"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- ★ 32.0.0 新增：自动开机 BIOS 引导 -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="自动开机（BIOS 定时唤醒）" Style="{StaticResource TitleText}"/>

                                    <TextBlock Text="Windows 关机后，操作系统已停止运行，任何软件都无法再唤醒电脑。"
                                               Style="{StaticResource NormalText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="要让电脑定时自动开机，必须靠主板 BIOS 的 RTC（实时时钟）定时唤醒功能。"
                                               Style="{StaticResource NormalText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>

                                    <TextBlock Text="· 2015 年以后的主板通常支持；老主板可能不支持。"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="· 进 BIOS 后，找 RTC Alarm / Wake Up Event / Power On By RTC 等选项。"
                                               Style="{StaticResource HintText}"
                                               Margin="0,2,0,0"/>

                                    <Button x:Name="btnOpenBiosGuide"
                                            Content="查看设置引导"
                                            Style="{StaticResource PclButtonPrimary}"
                                            HorizontalAlignment="Left"
                                            Margin="0,14,0,0"
                                            Click="BtnOpenBiosGuide_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 数据管理 -->
                        <StackPanel x:Name="PanelData" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="数据管理" Style="{StaticResource TitleText}"/>

                                    <Button Content="导出全部数据（.cmwdata）" Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnExportAll_Click"/>
                                    <Button Content="导入数据" Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnImportAll_Click"/>

                                    <Button Content="导出为 CSV（Excel 可打开）" Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnExportCsv_Click"/>

                                    <Button Content="查看回收站" Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnOpenRecycleBin_Click"/>

                                    <Button Content="查看所有笔记" Style="{StaticResource PclButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnViewNotes_Click"/>

                                    <Button Content="清空所有笔记" Style="{StaticResource PclButtonDanger}"
                                            HorizontalAlignment="Left" Margin="0,0,0,20" Click="BtnClearNotes_Click"/>

                                    <Border Background="#FFF8E1"
                                            BorderBrush="#FFD54F"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🔒 危险操作"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E65100"
                                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="清空所有数据需要密码验证。默认密码：12345678"
                                                       Style="{StaticResource HintText}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="清空所有数据" Style="{StaticResource PclButtonDanger}"
                                            HorizontalAlignment="Left" Margin="0,0,0,16" Click="BtnClearAllData_Click"/>

                                    <TextBlock Text="⚠️ 「清空所有数据」会删除：课表 / 值日 / 作业 / 待办 / 名单 / 考试 / 座位 / 日历 / 作业模板 / 投票 / 笔记 / 周报，以及回收站和催收记录。软件设置保留。"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,16"
                                               TextWrapping="Wrap"/>

                                    <Border Background="{DynamicResource ThemeCardBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="14"
                                            Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="修改清空密码"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                                       Margin="0,0,0,4"/>

                                            <TextBlock Text="密码不会显示在界面上，修改后立即生效。"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,0,0,10"/>

                                            <TextBlock Text="当前密码" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="pwdCurrent"
                                                         Height="32" Margin="0,0,0,10" MaxLength="32"
                                                         FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14"
                                                         Padding="8,0,8,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                                         Background="{DynamicResource ThemeInputBgBrush}"/>

                                            <TextBlock Text="新密码（至少 4 位）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="pwdNew"
                                                         Height="32" Margin="0,0,0,10" MaxLength="32"
                                                         FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14"
                                                         Padding="8,0,8,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                                         Background="{DynamicResource ThemeInputBgBrush}"/>

                                            <TextBlock Text="确认新密码" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="pwdConfirm"
                                                         Height="32" Margin="0,0,0,10" MaxLength="32"
                                                         FontFamily="{DynamicResource GlobalFontFamily}" FontSize="14"
                                                         Padding="8,0,8,0" VerticalContentAlignment="Center"
                                                         BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                                         Background="{DynamicResource ThemeInputBgBrush}"/>

                                            <Button x:Name="btnSaveClearPwd"
                                                    Content="更新密码"
                                                    Style="{StaticResource PclButtonPrimary}"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="100"
                                                    Click="BtnSaveClearPwd_Click"/>

                                            <TextBlock x:Name="tbPwdTip"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="提示：删除的作业 / 待办 / 值日组会先进入回收站，可在回收站恢复。"
                                               Style="{StaticResource HintText}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="CSV 导出：一次导出作业 / 待办 / 课表 / 值日 4 个文件，用 Excel 或 WPS 可直接打开。"
                                               Style="{StaticResource HintText}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 关于 -->
                        <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="关于 CMW 班级管理工具" Style="{StaticResource TitleText}"/>
                                    <TextBlock Style="{StaticResource NormalText}" TextWrapping="Wrap">
                                        版本：32.0.0
                                        <LineBreak/>
                                        设计：alpaca
                                        <LineBreak/>
                                        开发：WPF + Newtonsoft.Json
                                        <LineBreak/>
                                        框架：.NET 6.0
                                        <LineBreak/>
                                        适用：武汉外国语学校高中部
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="tbTip" Style="{StaticResource NormalText}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="btnSaveConfig" Content="保存设置"
                        Style="{StaticResource PclButtonPrimary}" Click="BtnSaveConfig_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>