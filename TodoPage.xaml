<UserControl x:Class="CMW.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <UserControl.Resources>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="待办事项"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnClearCompleted" Content="清空已完成"
                    Style="{StaticResource PclButton}"
                    Click="BtnClearCompletedTodo_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabAdd" Style="{StaticResource SubTabButton}"
                             Content="新增待办" GroupName="TodoTab"
                             Tag="M12 5 L12 19 M5 12 L19 12"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAll" Style="{StaticResource SubTabButton}"
                             Content="全部待办" GroupName="TodoTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabToday" Style="{StaticResource SubTabButton}"
                             Content="今日待办" GroupName="TodoTab"
                             Tag="M12 3 L15 9 L21 9 L16 13 L18 20 L12 16 L6 20 L8 13 L3 9 L9 9 Z"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>
                        <StackPanel x:Name="PanelAdd">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="新增待办" Style="{StaticResource TitleText}"/>

                                    <TextBlock Text="待办内容（回车可直接添加）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtTodoContent" Margin="0,0,0,12"
                                             KeyDown="TxtTodoContent_KeyDown"/>

                                    <TextBlock Text="备注（可选）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtRemark" Margin="0,0,0,12"/>

                                    <TextBlock Text="截止日期（可选）" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="dpTodoDeadline" Margin="0,0,0,14"/>

                                    <Button x:Name="btnAddTodo" Content="添加待办"
                                            Style="{StaticResource PclButtonPrimary}"
                                            HorizontalAlignment="Left"
                                            Click="BtnAddTodo_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelAll" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="全部待办" Style="{StaticResource TitleText}"/>
                                    <ItemsControl x:Name="icTodoList" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10"
                                                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"
                                                                  Checked="Todo_Checked"
                                                                  Unchecked="Todo_Unchecked"
                                                                  Tag="{Binding}"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Content}"
                                                                       Style="{StaticResource NormalText}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Remark}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeTextHintBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DeadlineText}"
                                                                   Style="{StaticResource NormalText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0"/>

                                                        <Button Grid.Column="3" Content="删除"
                                                                Style="{StaticResource SmallBtn}"
                                                                VerticalAlignment="Center"
                                                                Click="DeleteTodo_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="tbAllEmpty" Text="暂无待办"
                                               Style="{StaticResource PclEmptyText}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelToday" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="今日待办" Style="{StaticResource TitleText}"/>
                                    <ItemsControl x:Name="icTodayTodoList" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10"
                                                        BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox IsChecked="{Binding IsCompleted}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0"
                                                                  Checked="Todo_Checked"
                                                                  Unchecked="Todo_Unchecked"
                                                                  Tag="{Binding}"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Content}"
                                                                       Style="{StaticResource NormalText}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Remark}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeTextHintBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DeadlineText}"
                                                                   Style="{StaticResource NormalText}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0"/>

                                                        <Button Grid.Column="3" Content="删除"
                                                                Style="{StaticResource SmallBtn}"
                                                                VerticalAlignment="Center"
                                                                Click="DeleteTodo_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="tbTodayEmpty" Text="今日暂无待办 🎉"
                                               Style="{StaticResource PclEmptyText}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>