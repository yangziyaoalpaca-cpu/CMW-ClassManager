<Window x:Class="CMW.HomeworkTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作业模板"
        Width="640" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="作业模板"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>
            <TextBlock Text="选择模板快速填入作业，或新增常用模板"
                       FontSize="12" Foreground="{DynamicResource ThemeTextHintBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="panelTemplates" Margin="12"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="14"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="新增模板"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtName"
                             Grid.Column="0"
                             ToolTip="模板名称，如：每周英语背诵"/>

                    <TextBlock Grid.Column="1"
                               Text=" 科目 "
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <TextBox x:Name="txtSubject"
                             Grid.Column="2"/>

                    <TextBlock Grid.Column="3"
                               Text=" 优先级 "
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <ComboBox x:Name="cbPriority" Grid.Column="4">
                        <ComboBoxItem Content="普通" Tag="Normal" IsSelected="True"/>
                        <ComboBoxItem Content="紧急" Tag="Urgent"/>
                        <ComboBoxItem Content="非常紧急" Tag="VeryUrgent"/>
                    </ComboBox>

                    <TextBlock Grid.Column="5"
                               Text=" 天数 "
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <TextBox x:Name="txtDays"
                             Grid.Column="6"
                             Text="1"
                             TextAlignment="Center"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="tbTip"
                               Grid.Column="0"
                               FontSize="12"
                               Foreground="{DynamicResource ThemePrimaryBrush}"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="+ 添加模板"
                            Style="{StaticResource PclButtonPrimary}"
                            Margin="0,0,8,0"
                            Click="BtnAdd_Click"/>

                    <Button Grid.Column="2"
                            Content="关闭"
                            Style="{StaticResource PclButton}"
                            Click="BtnClose_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>