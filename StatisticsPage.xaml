<UserControl x:Class="CMW.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <UserControl.Resources>

        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="数据统计"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnRefresh"
                    Content="刷新数据"
                    Style="{StaticResource PclButton}"
                    Click="BtnRefresh_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabOverview" Style="{StaticResource SubTabButton}"
                             Content="概览" GroupName="StatsTab"
                             Tag="M4 4 L20 4 L20 20 L4 20 Z M8 16 L8 10 M12 16 L12 8 M16 16 L16 12"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="TabHomework" Style="{StaticResource SubTabButton}"
                             Content="作业趋势" GroupName="StatsTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabTodo" Style="{StaticResource SubTabButton}"
                             Content="待办趋势" GroupName="StatsTab"
                             Tag="M9 11 L11 13 L15 9 M19 3 L5 3 L5 21 L19 21 Z"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabDuty" Style="{StaticResource SubTabButton}"
                             Content="值日统计" GroupName="StatsTab"
                             Tag="M15 4 L20 9 L9 20 L4 21 L4 18 Z"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="PanelOverview" Grid.Row="0">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="总体概览" Style="{StaticResource TitleText}"/>

                                    <WrapPanel>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="今日作业" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="tbTodayHw" Text="0" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="作业完成率" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="tbHwRate" Text="0%" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="今日待办" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="tbTodayTodo" Text="0" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatCard}">
                                            <StackPanel>
                                                <TextBlock Text="今日值日" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="tbTodayDuty" Text="未安排"
                                                           Style="{StaticResource StatValue}"
                                                           FontSize="16"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="累计统计" Style="{StaticResource TitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="历史作业总数" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="tbTotalHw" Text="0"
                                                       Style="{StaticResource StatValue}"
                                                       FontSize="22"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="历史待办总数" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="tbTotalTodo" Text="0"
                                                       Style="{StaticResource StatValue}"
                                                       FontSize="22"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="考试记录数" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="tbTotalExam" Text="0"
                                                       Style="{StaticResource StatValue}"
                                                       FontSize="22"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelHomework" Grid.Row="1" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="近 14 天作业情况" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="蓝线 = 新增作业数 · 绿线 = 完成作业数"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="12"
                                            MinHeight="280">
                                        <Grid>
                                            <Canvas x:Name="cvHomework" Background="Transparent"/>
                                            <TextBlock x:Name="tbHomeworkEmpty" Text="暂无数据"
                                                       Style="{StaticResource PclEmptyText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelTodo" Grid.Row="2" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="近 14 天待办情况" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="橙线 = 新增待办数 · 蓝线 = 完成待办数"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="12"
                                            MinHeight="280">
                                        <Grid>
                                            <Canvas x:Name="cvTodo" Background="Transparent"/>
                                            <TextBlock x:Name="tbTodoEmpty" Text="暂无数据"
                                                       Style="{StaticResource PclEmptyText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PanelDuty" Grid.Row="3" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="值日组被选中次数" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="统计每个值日组被设为今日值日的次数"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusSmall}"
                                            Padding="12"
                                            MinHeight="280">
                                        <Grid>
                                            <Canvas x:Name="cvDuty" Background="Transparent"/>
                                            <TextBlock x:Name="tbDutyEmpty" Text="暂无数据"
                                                       Style="{StaticResource PclEmptyText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>