<Window x:Class="CMW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CMW"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CMW班级管理"
        Icon="{StaticResource AppIcon}"
        WindowStyle="None"
        Background="{DynamicResource ThemeBackgroundBrush}"
        ResizeMode="CanResize"
        Width="1100" Height="720"
        FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid"
          Background="{DynamicResource ThemeBackgroundBrush}"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ThemeTitleBarBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CMW"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeTitleBarTextBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           VerticalAlignment="Center"
                           Margin="20,0,20,0"/>

                <TextBlock Grid.Column="1"
                           Text="班级管理工具"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTitleBarTextBrush}"
                           Opacity="0.7"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           VerticalAlignment="Center"
                           Margin="0,1,0,0"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource WindowControlButton}"
                            Click="BtnMinimize_Click"
                            ToolTip="最小化到灵动岛">
                        <Path Data="M 0,0 L 10,0"
                              Stroke="{DynamicResource ThemeTitleBarTextBrush}"
                              StrokeThickness="1"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource WindowControlButton}"
                            Click="BtnMaximize_Click"
                            ToolTip="最大化 / 还原">
                        <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                              Stroke="{DynamicResource ThemeTitleBarTextBrush}"
                              StrokeThickness="1"
                              Fill="Transparent"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{StaticResource WindowCloseButton}"
                            Click="BtnClose_Click"
                            ToolTip="关闭到灵动岛">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource ThemeTitleBarTextBrush}"
                              StrokeThickness="1"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource ThemeCardBrush}"
                    BorderBrush="{DynamicResource ThemeShadowLineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="4,10,4,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <RadioButton x:Name="NavHome"
                                     Style="{StaticResource NavButton}"
                                     Content="首页"
                                     Tag="{StaticResource IconHome}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSchedule"
                                     Style="{StaticResource NavButton}"
                                     Content="课表"
                                     Tag="{StaticResource IconSchedule}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTodo"
                                     Style="{StaticResource NavButton}"
                                     Content="待办"
                                     Tag="{StaticResource IconTodo}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDuty"
                                     Style="{StaticResource NavButton}"
                                     Content="值日"
                                     Tag="{StaticResource IconDuty}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavHomework"
                                     Style="{StaticResource NavButton}"
                                     Content="作业"
                                     Tag="{StaticResource IconHomework}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSummary"
                                     Style="{StaticResource NavButton}"
                                     Content="汇总"
                                     Tag="{StaticResource IconSummary}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStudents"
                                     Style="{StaticResource NavButton}"
                                     Content="名单"
                                     Tag="{StaticResource IconStudents}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavExam"
                                     Style="{StaticResource NavButton}"
                                     Content="考试"
                                     Tag="{StaticResource IconExam}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLogs"
                                     Style="{StaticResource NavButton}"
                                     Content="周报"
                                     Tag="{StaticResource IconLogs}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStatistics"
                                     Style="{StaticResource NavButton}"
                                     Content="统计"
                                     Tag="{StaticResource IconStatistics}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSeat"
                                     Style="{StaticResource NavButton}"
                                     Content="座位"
                                     Tag="{StaticResource IconSeat}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavCalendar"
                                     Style="{StaticResource NavButton}"
                                     Content="日历"
                                     Tag="{StaticResource IconCalendar}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings"
                                     Style="{StaticResource NavButton}"
                                     Content="设置"
                                     Tag="{StaticResource IconSettings}"
                                     GroupName="NavGroup"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid x:Name="FrameHost"
                  Grid.Column="1"
                  Background="{DynamicResource ThemeBackgroundBrush}"
                  ClipToBounds="True"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="FrameTranslate" X="0"/>
                </Grid.RenderTransform>
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</Window>