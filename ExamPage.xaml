<UserControl x:Class="CMW.ExamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <UserControl.Resources>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerSmallBtn" TargetType="Button" BasedOn="{StaticResource PclButtonDanger}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="考试 / 成绩"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnExportCsv" Content="导出 CSV"
                    Style="{StaticResource PclButton}"
                    Click="BtnExportCsv_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabAdd" Style="{StaticResource SubTabButton}"
                             Content="录入成绩" GroupName="ExamTab"
                             Tag="M12 5 L12 19 M5 12 L19 12"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabList" Style="{StaticResource SubTabButton}"
                             Content="成绩列表" GroupName="ExamTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabTrend" Style="{StaticResource SubTabButton}"
                             Content="趋势图" GroupName="ExamTab"
                             Tag="M3 17 L9 11 L13 15 L21 7"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>
                        <!-- 录入 -->
                        <StackPanel x:Name="PanelAdd">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="录入考试成绩" Style="{StaticResource TitleText}"/>

                                    <TextBlock Text="考试名称" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtExamName" Margin="0,0,0,12"
                                             ToolTip="例：2026 春季期中考试"/>

                                    <TextBlock Text="科目" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSubject" Margin="0,0,0,12"
                                             ToolTip="例：数学"/>

                                    <TextBlock Text="考试日期" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="dpExamDate" Margin="0,0,0,12"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="班级平均分" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtAverage" Margin="0,0,0,0"
                                                     ToolTip="例：85.5（可留空）"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="最高分" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtHighest" Margin="0,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="最低分" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtLowest" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="备注（可选）" Style="{StaticResource NormalText}" Margin="0,12,0,4"/>
                                    <TextBox x:Name="txtRemark" Margin="0,0,0,16"/>

                                    <Button x:Name="btnAdd" Content="添加记录"
                                            Style="{StaticResource PclButtonPrimary}"
                                            HorizontalAlignment="Left"
                                            Click="BtnAdd_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 列表 -->
                        <StackPanel x:Name="PanelList" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="成绩列表" Style="{StaticResource TitleText}"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1,1,1,1"
                                            CornerRadius="4,4,0,0"
                                            Height="36">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="日期"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="考试名称"
                                                       Style="{StaticResource TableHeaderText}"
                                                       Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="科目"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="平均分"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="最高"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="最低"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="操作"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,4,4"
                                            ClipToBounds="True">
                                        <ItemsControl x:Name="icExamList" AlternationCount="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="42"
                                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding DateText}"
                                                                       Style="{StaticResource NormalText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ExamName}"
                                                                       Style="{StaticResource NormalText}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="12,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Subject}"
                                                                       Style="{StaticResource NormalText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding AverageText}"
                                                                       Style="{StaticResource NormalText}"
                                                                       Foreground="{DynamicResource ThemePrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding HighestText}"
                                                                       Style="{StaticResource NormalText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding LowestText}"
                                                                       Style="{StaticResource NormalText}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="6"
                                                                    Content="删除"
                                                                    Style="{StaticResource DangerSmallBtn}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Click="DeleteExam_Click"
                                                                    Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock x:Name="tbEmpty" Text="暂无成绩记录"
                                               Style="{StaticResource PclEmptyText}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 趋势 -->
                        <StackPanel x:Name="PanelTrend" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="班级平均分趋势" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="按科目分开显示；同一科目按考试日期排序"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource GlobalCornerRadius}"
                                            Padding="16"
                                            MinHeight="260">
                                        <Grid>
                                            <Canvas x:Name="cvTrend" Background="Transparent"/>
                                            <TextBlock x:Name="tbTrendEmpty" Text="暂无数据"
                                                       Style="{StaticResource PclEmptyText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="tbTrendLegend"
                                               Style="{StaticResource HintText}"
                                               Margin="0,12,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>