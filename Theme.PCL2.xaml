<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主题色 · PCL2 -->
    <SolidColorBrush x:Key="ThemePrimaryBrush" Color="#1E5FD0"/>
    <SolidColorBrush x:Key="ThemePrimaryHoverBrush" Color="#2E6FDD"/>
    <SolidColorBrush x:Key="ThemePrimaryPressedBrush" Color="#174CA8"/>
    <SolidColorBrush x:Key="ThemePrimaryLightBrush" Color="#7BAAF7"/>
    <SolidColorBrush x:Key="ThemePrimaryBgBrush" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="ThemePrimaryBgHoverBrush" Color="#D0E2FC"/>

    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#E8EBF0"/>
    <SolidColorBrush x:Key="ThemeCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="#D0D4DA"/>
    <SolidColorBrush x:Key="ThemeBorderLightBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ThemeRowAltBrush" Color="#FAFAFA"/>

    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="ThemeTextHintBrush" Color="#A0A0A0"/>

    <SolidColorBrush x:Key="ThemeTitleBarBrush" Color="#1E5FD0"/>
    <SolidColorBrush x:Key="ThemeTitleBarTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ThemeDangerBrush" Color="#D32F2F"/>
    <SolidColorBrush x:Key="ThemeDangerHoverBrush" Color="#E81123"/>

    <SolidColorBrush x:Key="ThemeInputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#B8C8D8"/>

    <!-- ★ 33.0.0：PCL2 假阴影描线色（浅色主题用黑 8%） -->
    <SolidColorBrush x:Key="ThemeShadowLineBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ThemeShadowLineLightBrush" Color="#0A000000"/>

    <!-- ★ 33.0.0：侧栏选中高亮背景 -->
    <SolidColorBrush x:Key="ThemeNavActiveBgBrush" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="ThemeNavHoverBgBrush" Color="#F0F4FA"/>

    <!-- ★ 33.0.0：子选项卡选中竖条色 -->
    <SolidColorBrush x:Key="ThemeTabAccentBrush" Color="#1E5FD0"/>

    <!-- 图标前景色 -->
    <SolidColorBrush x:Key="ThemeIconForegroundBrush" Color="#1E5FD0"/>

    <!-- 兼容旧 Key -->
    <SolidColorBrush x:Key="PclPrimaryBrush" Color="#1E5FD0"/>
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="#E8EBF0"/>

</ResourceDictionary>