<UserControl x:Class="CMW.LessonCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource GlobalFontFamily}"
             Width="Auto" Height="Auto">

    <Border Style="{StaticResource GlassCard}"
            Margin="2"
            Padding="6">
        <StackPanel>
            <Border Background="#2B3A4D" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,4" Margin="0,0,0,4">
                <Grid>
                    <TextBox x:Name="tbCourse"
                             FontFamily="{DynamicResource GlobalFontFamily}"
                             FontSize="12"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="TbCourse_TextChanged"/>
                    <TextBlock x:Name="WatermarkCourse"
                               Text="课程名称"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="12"
                               Foreground="#9AA7B8"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Background="#2B3A4D" CornerRadius="{DynamicResource RadiusSmall}" Padding="6,4">
                <Grid>
                    <TextBox x:Name="tbTeacher"
                             FontFamily="{DynamicResource GlobalFontFamily}"
                             FontSize="12"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="TbTeacher_TextChanged"/>
                    <TextBlock x:Name="WatermarkTeacher"
                               Text="老师"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="12"
                               Foreground="#9AA7B8"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>