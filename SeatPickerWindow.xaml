<Window x:Class="CMW.SeatPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择学生"
        Width="520" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ★ 33.0.0：单击即选中的学生卡片 -->
        <Style x:Key="StudentPickCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeShadowLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource GlobalCornerRadius}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeNavHoverBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="tbTitle" Text="选择学生"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>
            <TextBlock x:Name="tbSubtitle"
                       Text="点击学生姓名即可安排到该座位"
                       FontSize="12" Foreground="{DynamicResource ThemeTextHintBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeShadowLineBrush}"
                BorderThickness="0,0,1,1"
                CornerRadius="{DynamicResource GlobalCornerRadius}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch"
                         Grid.Column="0"
                         ToolTip="输入姓名或学号搜索"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button Grid.Column="1"
                        Content="清除此座位"
                        Style="{StaticResource PclButton}"
                        Margin="8,0,0,0"
                        Click="BtnClearSeat_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeShadowLineBrush}"
                BorderThickness="0,0,1,1"
                CornerRadius="{DynamicResource GlobalCornerRadius}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="icStudents" Margin="8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StudentPickCard}"
                                        MouseLeftButtonUp="StudentCard_MouseLeftButtonUp"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayText}"
                                                   FontFamily="{DynamicResource GlobalFontFamily}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="✓"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource ThemePrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedCheckVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="tbEmpty"
                           Text="名单为空，请先到「名单」页添加学生"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeTextHintBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbTip"
                       Grid.Column="0"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="取消"
                    Style="{StaticResource PclButton}"
                    Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>