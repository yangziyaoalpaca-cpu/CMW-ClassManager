<Window x:Class="CMW.SeatPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择学生"
        Width="520" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#E8EBF0">

    <Window.Resources>

        <!-- ★ 27.1.0：补上 HintText -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Part" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudentToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd"
                                Background="#FFFFFF"
                                BorderBrush="#D8DCE0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Tick"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        Background="#E0E0E0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TickText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Lbl"
                                           Text="{TemplateBinding Content}"
                                           Margin="10,0,0,0"
                                           FontSize="13"
                                           FontFamily="Microsoft YaHei UI"
                                           Foreground="#404040"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7BAAF7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E5FD0"/>
                                <Setter TargetName="Tick" Property="Background" Value="#1E5FD0"/>
                                <Setter TargetName="TickText" Property="Text" Value="✓"/>
                                <Setter TargetName="Lbl" Property="Foreground" Value="#1E5FD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="tbTitle" Text="选择学生"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#202020"
                       FontFamily="Microsoft YaHei UI"/>
            <TextBlock x:Name="tbSubtitle"
                       Text="点击选择一个学生放入该座位"
                       FontSize="12" Foreground="#808080"
                       FontFamily="Microsoft YaHei UI"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E1E1E1"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch"
                         Grid.Column="0"
                         ToolTip="输入姓名或学号搜索"
                         TextChanged="TxtSearch_TextChanged"/>
                <Button Grid.Column="1"
                        Content="清除此座位"
                        Style="{StaticResource PclButton}"
                        Margin="8,0,0,0"
                        Click="BtnClearSeat_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E1E1E1"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl x:Name="icStudents" Margin="12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource StudentToggle}"
                                      Content="{Binding DisplayText}"
                                      Margin="4"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="Student_Checked"
                                      Unchecked="Student_Unchecked"
                                      Tag="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbTip"
                       Grid.Column="0"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="取消"
                    Style="{StaticResource PclButton}"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="2"
                    Content="确定"
                    Style="{StaticResource PclButtonPrimary}"
                    Click="BtnOk_Click"/>
        </Grid>
    </Grid>
</Window>