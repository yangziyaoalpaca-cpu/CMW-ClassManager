<Window x:Class="CMW.DayEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="当天活动"
        Width="520" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource ThemeBackgroundBrush}"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>
        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="tbDateTitle"
                       Text="2026 年 9 月 29 日 星期一"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"/>
            <TextBlock Text="在此日期内新增或删除活动"
                       FontSize="12" Foreground="{DynamicResource ThemeTextHintBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="新增活动"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtEventTitle"
                             Grid.Column="0"
                             ToolTip="活动名称"
                             KeyDown="TxtEventTitle_KeyDown"/>
                    <TextBlock Grid.Column="1"
                               Text=" 分类 "
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"/>
                    <ComboBox x:Name="cbCategory" Grid.Column="2">
                        <ComboBoxItem Content="活动" Tag="活动" IsSelected="True"/>
                        <ComboBoxItem Content="考试" Tag="考试"/>
                        <ComboBoxItem Content="班会" Tag="班会"/>
                        <ComboBoxItem Content="运动会" Tag="运动会"/>
                        <ComboBoxItem Content="其他" Tag="其他"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtRemark"
                             Grid.Column="0"
                             ToolTip="备注（可选）"/>
                    <Button Grid.Column="1"
                            Content="+ 添加"
                            Style="{StaticResource PclButtonPrimary}"
                            Margin="8,0,0,0"
                            Click="BtnAdd_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource ThemeCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="panelEvents" Margin="12"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbTip"
                       Grid.Column="0"
                       FontSize="12"
                       Foreground="{DynamicResource ThemePrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="关闭"
                    Style="{StaticResource PclButton}"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>