<UserControl x:Class="CMW.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="班级日历"
                       FontSize="24" FontWeight="Bold"
                       Foreground="#202020" FontFamily="Microsoft YaHei UI"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="新增活动"
                    Style="{StaticResource PclButtonPrimary}"
                    Click="BtnAddEvent_Click"/>
        </Grid>

        <!-- 月份切换 -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="◀ 上月"
                        Style="{StaticResource PclButton}"
                        Click="BtnPrevMonth_Click"/>

                <TextBlock x:Name="tbMonthTitle"
                           Grid.Column="1"
                           Text="2026 年 9 月"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#202020"
                           FontFamily="Microsoft YaHei UI"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="今天"
                            Style="{StaticResource PclButton}"
                            Margin="0,0,8,0"
                            Click="BtnToday_Click"/>
                    <Button Content="下月 ▶"
                            Style="{StaticResource PclButton}"
                            Click="BtnNextMonth_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 日历主体 -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 星期头 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周一" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周二" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周三" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周四" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周五" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周六" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="6" Background="#F5F5F5" BorderBrush="#D8DCE0" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周日" FontSize="13" FontWeight="SemiBold" Foreground="#202020" FontFamily="Microsoft YaHei UI" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 日期网格 -->
                <Grid x:Name="gridCalendar" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="3"
                   x:Name="tbTip"
                   Style="{StaticResource HintText}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>