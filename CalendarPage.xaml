<UserControl x:Class="CMW.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="班级日历"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="新增活动"
                    Style="{StaticResource PclButtonPrimary}"
                    Click="BtnAddEvent_Click"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="◀ 上月"
                        Style="{StaticResource PclButton}"
                        Click="BtnPrevMonth_Click"/>

                <TextBlock x:Name="tbMonthTitle"
                           Grid.Column="1"
                           Text="2026 年 9 月"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="今天"
                            Style="{StaticResource PclButton}"
                            Margin="0,0,8,0"
                            Click="BtnToday_Click"/>
                    <Button Content="下月 ▶"
                            Style="{StaticResource PclButton}"
                            Click="BtnNextMonth_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周一" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周二" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周三" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周四" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周五" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="5" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周六" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="6" Background="{DynamicResource ThemeRowAltBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,6" Margin="1">
                        <TextBlock Text="周日" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="{DynamicResource GlobalFontFamily}" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <Grid x:Name="gridCalendar" Grid.Row="1"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="tbTip"
                   Style="{StaticResource HintText}"
                   Margin="0,8,0,0"/>
    </Grid>
</UserControl>