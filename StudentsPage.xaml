<UserControl x:Class="CMW.StudentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent">

    <UserControl.Resources>

        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#1E5FD0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#404040"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerSmallBtn" TargetType="Button" BasedOn="{StaticResource PclButtonDanger}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#202020"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IosToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="#CCCCCC">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1E5FD0"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0"
                                                        CornerRadius="5"
                                                        Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="班级名单"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#202020" FontFamily="Microsoft YaHei UI"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabRoster" Style="{StaticResource SubTabButton}"
                             Content="名单管理" GroupName="StudentsTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabPicker" Style="{StaticResource SubTabButton}"
                             Content="随机点名" GroupName="StudentsTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabPoll" Style="{StaticResource SubTabButton}"
                             Content="班级投票" GroupName="StudentsTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>

                        <!-- ═══════ 名单管理 ═══════ -->
                        <StackPanel x:Name="PanelRoster">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="名单管理" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="支持逐条录入 / 批量粘贴 / CSV 导入；姓名是其他功能的唯一来源（点名、投票、座位表）"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"
                                               TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="添加学生"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Margin="0,0,10,0"
                                                Click="BtnAdd_Click"/>
                                        <Button Content="CSV 导入"
                                                Style="{StaticResource PclButton}"
                                                Margin="0,0,10,0"
                                                Click="BtnImportCsv_Click"/>
                                        <Button Content="导出 CSV"
                                                Style="{StaticResource PclButton}"
                                                Margin="0,0,10,0"
                                                Click="BtnExportCsv_Click"/>
                                        <Button Content="清空全部"
                                                Style="{StaticResource PclButtonDanger}"
                                                Click="BtnClearAll_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="tbCount" Text="共 0 名学生"
                                               Style="{StaticResource NormalText}"
                                               Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#F5F5F5"
                                            BorderBrush="#D8DCE0"
                                            BorderThickness="1,1,1,1"
                                            CornerRadius="8,8,0,0"
                                            Height="36">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="学号"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="姓名"
                                                       Style="{StaticResource TableHeaderText}"
                                                       Margin="16,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="操作"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            BorderBrush="#D8DCE0"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,8,8"
                                            ClipToBounds="True"
                                            MinHeight="240"
                                            MaxHeight="520">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          PanningMode="VerticalOnly">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                                                </ScrollViewer.Resources>

                                                <ItemsControl x:Name="icStudents" AlternationCount="2">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="42"
                                                                    BorderBrush="#F0F0F0"
                                                                    BorderThickness="0,0,0,1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                                <Setter Property="Background" Value="#FAFAFA"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding StudentId}"
                                                                               Style="{StaticResource NormalText}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Name}"
                                                                               Style="{StaticResource NormalText}"
                                                                               FontWeight="SemiBold"
                                                                               Margin="16,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <Button Grid.Column="2"
                                                                            Content="删除"
                                                                            Style="{StaticResource DangerSmallBtn}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Click="DeleteStudent_Click"
                                                                            Tag="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock x:Name="tbEmpty" Text="暂无学生，点上方「添加学生」或「CSV 导入」"
                                                       FontSize="13"
                                                       Foreground="#A0A0A0"
                                                       FontFamily="Microsoft YaHei UI"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ═══════ 随机点名 ═══════ -->
                        <StackPanel x:Name="PanelPicker" Visibility="Collapsed">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="随机点名" Style="{StaticResource TitleText}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="tbPickerCounter"
                                                   Grid.Column="0"
                                                   Style="{StaticResource NormalText}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <CheckBox x:Name="ChkNoRepeat"
                                                      Content="本轮不重复"
                                                      IsChecked="True"
                                                      Style="{StaticResource IosToggle}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0"/>
                                            <Button Content="重置本轮"
                                                    Style="{StaticResource PclButton}"
                                                    Click="BtnPickerReset_Click"
                                                    Margin="0,0,8,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}" Padding="30">
                                <StackPanel HorizontalAlignment="Center" Margin="0,20,0,20">
                                    <TextBlock x:Name="tbPickerStatus"
                                               Text="点击下方「开始」按钮"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="16"
                                               Foreground="#808080"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,16"/>
                                    <TextBlock x:Name="tbPickerName"
                                               Text="—"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="96"
                                               FontWeight="Bold"
                                               Foreground="#1E5FD0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="tbPickerSubtitle"
                                               Text=""
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="16"
                                               Foreground="#606060"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <Button x:Name="BtnPickerStart"
                                        Content="开始"
                                        Click="BtnPickerStart_Click"
                                        Background="#1E5FD0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontFamily="Microsoft YaHei UI"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Height="56"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="20,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#2E6FDD"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#174CA8"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bg" Property="Background" Value="#C0C0C0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="本轮已抽" Style="{StaticResource TitleText}"/>
                                    <TextBlock x:Name="tbPickerHistory"
                                               Text="（暂无）"
                                               Style="{StaticResource NormalText}"
                                               TextWrapping="Wrap"
                                               LineHeight="24"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════ 班级投票 ═══════ -->
                        <StackPanel x:Name="PanelPoll" Visibility="Collapsed">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="班级投票" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="确定一个主题 → 点击学生姓名 = 标记他/她已投票；点卡片右上 ⚙ 可改此人的可投票数（权重）"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,12"
                                               TextWrapping="Wrap"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="cbPollSelect"
                                                  Grid.Column="0"
                                                  Margin="0,0,10,0"
                                                  SelectionChanged="CbPollSelect_SelectionChanged"/>

                                        <Button Grid.Column="1"
                                                Content="新建投票"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Margin="0,0,8,0"
                                                Click="BtnNewPoll_Click"/>

                                        <Button Grid.Column="2"
                                                Content="重置投票"
                                                Style="{StaticResource PclButton}"
                                                Margin="0,0,8,0"
                                                Click="BtnResetPollVotes_Click"/>

                                        <Button Grid.Column="3"
                                                Content="删除投票"
                                                Style="{StaticResource PclButtonDanger}"
                                                Click="BtnDeletePoll_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="tbPollTitle"
                                               Grid.Column="0"
                                               Text="（未选择投票）"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#202020"
                                               FontFamily="Microsoft YaHei UI"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="tbPollTotal"
                                               Grid.Column="1"
                                               Style="{StaticResource HintText}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="560">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <UniformGrid x:Name="ugPollStudents" Columns="5"/>
                                    </ScrollViewer>

                                    <TextBlock x:Name="tbPollEmpty"
                                               Text="暂无投票。点上方「新建投票」创建，例如：是否同意周一提前到校"
                                               Style="{StaticResource PclEmptyText}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>