<Window x:Class="CMW.ClassBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电子班牌"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0E1520"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5B9DF0"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#E8EBF0"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#607080"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="ExitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#405070"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22E81123"/>
                                <Setter Property="Foreground" Value="#FF8080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="60,40,60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="tbClassName"
                       Text="班级"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock x:Name="tbDateTime"
                           Text="2026-09-29 星期一 14:23:45"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           FontSize="34"
                           Foreground="#B0C0D8"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"/>
                <Button x:Name="BtnExit"
                        Content="✕ 关闭班牌"
                        Click="BtnExit_Click"
                        Style="{StaticResource ExitButton}"
                        ToolTip="关闭电子班牌"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Height="2"
                Background="#1A2535"
                Margin="0,24,0,32"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <TextBlock Text="📚 今日课表" Style="{StaticResource ColumnTitle}"/>
                <ItemsControl x:Name="icSchedule">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="tbScheduleEmpty"
                           Text="今日无课程"
                           Style="{StaticResource EmptyText}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,32,0">
                <TextBlock Text="📝 今日作业" Style="{StaticResource ColumnTitle}"/>
                <ItemsControl x:Name="icHomework">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="tbHomeworkEmpty"
                           Text="今日无作业"
                           Style="{StaticResource EmptyText}"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="👥 今日值日" Style="{StaticResource ColumnTitle}"/>
                    <TextBlock x:Name="tbDutyName"
                               Text="未安排"
                               FontFamily="{DynamicResource GlobalFontFamily}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="tbDutyMembers"
                               Text=""
                               Style="{StaticResource BodyText}"
                               FontSize="18"
                               Foreground="#B0C0D8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,36,0,0">
                    <TextBlock Text="✅ 今日待办" Style="{StaticResource ColumnTitle}"/>
                    <ItemsControl x:Name="icTodo">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="tbTodoEmpty"
                               Text="暂无待办"
                               Style="{StaticResource EmptyText}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ★ C3：底部倒计时条（前 3 条） -->
        <Border Grid.Row="3"
                x:Name="ExamCountdownBar"
                Background="#1A2535"
                CornerRadius="{DynamicResource RadiusLarge}"
                Padding="32,20"
                Margin="0,32,0,0"
                Visibility="Collapsed">
            <ItemsControl x:Name="icExamCountdowns">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,4">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                       FontSize="28"
                                       Foreground="#B0C0D8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" 还有 "
                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                       FontSize="28"
                                       Foreground="#B0C0D8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DaysLeft}"
                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Foreground="#5B9DF0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="天"
                                       FontFamily="{DynamicResource GlobalFontFamily}"
                                       FontSize="28"
                                       Foreground="#B0C0D8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</Window>