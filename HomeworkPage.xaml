<UserControl x:Class="CMW.HomeworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMW"
             Background="Transparent"
             FontFamily="{DynamicResource GlobalFontFamily}">

    <UserControl.Resources>

        <Style x:Key="SubTabButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Icon"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ThemePrimaryBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="NormalText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource PclButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DangerSmallBtn" TargetType="Button" BasedOn="{StaticResource PclButtonDanger}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PriorityTag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeBorderLightBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IosToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44" Height="24"
                                CornerRadius="12"
                                Background="#CCCCCC">
                            <Ellipse x:Name="Thumb"
                                     Width="18" Height="18"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TouchScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" CornerRadius="5" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="作业管理"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnClearCompleted" Content="清空已完成"
                    Style="{StaticResource PclButton}"
                    Click="BtnClearCompleted_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <RadioButton x:Name="TabAdd" Style="{StaticResource SubTabButton}"
                             Content="新增作业" GroupName="HomeworkTab"
                             Tag="M12 5 L12 19 M5 12 L19 12"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="TabList" Style="{StaticResource SubTabButton}"
                             Content="作业列表" GroupName="HomeworkTab"
                             Tag="M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabToday" Style="{StaticResource SubTabButton}"
                             Content="今日作业" GroupName="HomeworkTab"
                             Tag="M12 3 L15 9 L21 9 L16 13 L18 20 L12 16 L6 20 L8 13 L3 9 L9 9 Z"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
                <RadioButton x:Name="TabRemindConfig" Style="{StaticResource SubTabButton}"
                             Content="催收设置" GroupName="HomeworkTab"
                             Tag="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 L12 12 L15 15"
                             Checked="Tab_Checked" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="Transparent">
                <ScrollViewer x:Name="ContentScroll"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource TouchScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 新增作业 -->
                        <StackPanel x:Name="PanelAdd" Grid.Row="0" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="新增作业" Style="{StaticResource TitleText}"/>
                                    <TextBlock Text="作业名称（回车可直接添加）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtHomeworkName" Margin="0,0,0,12"
                                             KeyDown="TxtHomeworkName_KeyDown"/>

                                    <TextBlock Text="科目" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtSubject" Margin="0,0,0,12"/>

                                    <TextBlock Text="开始时间（日期 + 时:分）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker x:Name="dpStartDate" Grid.Column="0"/>
                                        <TextBlock Grid.Column="1" Text=" 时 " VerticalAlignment="Center"
                                                           Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtStartHour" Grid.Column="2"
                                                 Text="08" MaxLength="2" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text=" : " VerticalAlignment="Center"
                                                           Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtStartMin" Grid.Column="4"
                                                 Text="00" MaxLength="2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="截止时间（日期 + 时:分）"
                                               Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePicker x:Name="dpEndDate" Grid.Column="0"/>
                                        <TextBlock Grid.Column="1" Text=" 时 " VerticalAlignment="Center"
                                                           Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtEndHour" Grid.Column="2"
                                                 Text="22" MaxLength="2" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text=" : " VerticalAlignment="Center"
                                                           Style="{StaticResource NormalText}"/>
                                        <TextBox x:Name="txtEndMin" Grid.Column="4"
                                                 Text="00" MaxLength="2" TextAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="优先级" Style="{StaticResource NormalText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbPriority" Margin="0,0,0,12">
                                        <ComboBoxItem Content="普通" Tag="Normal"/>
                                        <ComboBoxItem Content="紧急" Tag="Urgent"/>
                                        <ComboBoxItem Content="非常紧急" Tag="VeryUrgent"/>
                                    </ComboBox>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="需要交" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="关闭后不参与催收，但仍在今日作业中显示"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleNeedSubmit"
                                                  Grid.Column="1"
                                                  IsChecked="True"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnAddHomework" Content="添加作业"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Margin="0,0,12,0"
                                                Click="BtnAddHomework_Click"/>
                                        <Button x:Name="btnFromTemplate" Content="从模板添加"
                                                Style="{StaticResource PclButton}"
                                                Click="BtnFromTemplate_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 作业列表 -->
                        <StackPanel x:Name="PanelList" Grid.Row="1" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="作业列表" Style="{StaticResource TitleText}"/>

                                    <Border Background="{DynamicResource ThemeRowAltBrush}"
                                            BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1,1,1,1"
                                            CornerRadius="4,4,0,0"
                                            Height="36">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="完成"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="作业名称"
                                                       Style="{StaticResource TableHeaderText}"
                                                       Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="科目"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="截止时间"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="优先级"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="要交"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="操作"
                                                       Style="{StaticResource TableHeaderText}"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                                            BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,4,4"
                                            ClipToBounds="True">
                                        <ItemsControl x:Name="icHomeworkList" AlternationCount="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="44"
                                                            BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                                                            BorderThickness="0,0,0,1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="180"/>
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsCompleted}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Checked="CheckBox_Checked"
                                                                      Unchecked="CheckBox_Unchecked"
                                                                      Tag="{Binding}"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding HomeworkName}"
                                                                       Style="{StaticResource NormalText}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,8,0"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Subject}"
                                                                       Style="{StaticResource NormalText}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding DateRangeText}"
                                                                       Style="{StaticResource NormalText}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="12"/>

                                                            <Border Grid.Column="4"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border" BasedOn="{StaticResource PriorityTag}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                                <Setter Property="Background" Value="{DynamicResource ThemePrimaryBgHoverBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Priority}" Value="VeryUrgent">
                                                                                <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding PriorityText}"
                                                                           FontSize="12"
                                                                           FontFamily="{DynamicResource GlobalFontFamily}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Priority}" Value="VeryUrgent">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <TextBlock Grid.Column="5"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontFamily="{DynamicResource GlobalFontFamily}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="✅"/>
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NeedSubmit}" Value="False">
                                                                                <Setter Property="Text" Value="—"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextHintBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <StackPanel Grid.Column="6"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="点名"
                                                                        Style="{StaticResource SmallBtn}"
                                                                        Margin="0,0,6,0"
                                                                        Click="RollCall_Click"
                                                                        Tag="{Binding}"/>
                                                                <Button Content="编辑"
                                                                        Style="{StaticResource SmallBtn}"
                                                                        Margin="0,0,6,0"
                                                                        Click="EditHomework_Click"
                                                                        Tag="{Binding}"/>
                                                                <Button Content="删除"
                                                                        Style="{StaticResource SmallBtn}"
                                                                        Click="DeleteHomework_Click"
                                                                        Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock x:Name="tbAllEmpty" Text="暂无作业"
                                               Style="{StaticResource PclEmptyText}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 今日作业 -->
                        <StackPanel x:Name="PanelToday" Grid.Row="2" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="今日作业" Style="{StaticResource TitleText}"/>
                                    <TextBlock x:Name="tbTodayHomework"
                                               Style="{StaticResource NormalText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnViewToday" Content="查看今日作业详情"
                                                Style="{StaticResource PclButton}"
                                                Margin="0,0,12,0"
                                                Click="BtnViewToday_Click"/>
                                        <Button x:Name="btnCopyToday" Content="复制今日作业文本"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Click="BtnCopyToday_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="tbCopyTip"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 催收设置 -->
                        <StackPanel x:Name="PanelRemindConfig" Grid.Row="3" Visibility="Collapsed">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="催收设置" Style="{StaticResource TitleText}"/>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="启用作业催收" Style="{StaticResource NormalText}"/>
                                            <TextBlock Text="到点时灵动岛自动展开，滚动显示未交名单（已过期的作业不催收）"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <CheckBox x:Name="toggleRemindEnabled"
                                                  Grid.Column="1"
                                                  Style="{StaticResource IosToggle}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="催收时间点（HH:mm）"
                                                   Style="{StaticResource NormalText}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="清空全部"
                                                Style="{StaticResource DangerSmallBtn}"
                                                Click="BtnClearAllRemindTimes_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtNewRemindTime"
                                                 Grid.Column="0"
                                                 ToolTip="例：17:00"
                                                 KeyDown="TxtNewRemindTime_KeyDown"/>
                                        <Button Grid.Column="2"
                                                Content="添加"
                                                Style="{StaticResource PclButtonPrimary}"
                                                Click="BtnAddRemindTime_Click"/>
                                    </Grid>

                                    <ItemsControl x:Name="icRemindTimes" Margin="0,8,0,16">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeRowAltBrush}"
                                                        BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusSmall}"
                                                        Padding="12,8"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding}"
                                                                   FontSize="14"
                                                                   FontFamily="{DynamicResource GlobalFontFamily}"
                                                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Content="删除"
                                                                Style="{StaticResource SmallBtn}"
                                                                Click="BtnDeleteRemindTime_Click"
                                                                Tag="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="滚动速度"
                                               Style="{StaticResource NormalText}"
                                               Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderScrollSpeed"
                                            Minimum="20" Maximum="150"
                                            Value="60"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbScrollSpeed"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <TextBlock Text="自动展开时长（秒）"
                                               Style="{StaticResource NormalText}"
                                               Margin="0,0,0,4"/>
                                    <Slider x:Name="sliderRemindDuration"
                                            Minimum="30" Maximum="300"
                                            Value="120"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            Margin="0,0,0,4"/>
                                    <TextBlock x:Name="tbRemindDuration"
                                               Style="{StaticResource HintText}"
                                               Margin="0,0,0,14"/>

                                    <Button Content="保存设置"
                                            Style="{StaticResource PclButtonPrimary}"
                                            HorizontalAlignment="Left"
                                            Click="BtnSaveRemindConfig_Click"/>

                                    <TextBlock x:Name="tbRemindConfigTip"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>