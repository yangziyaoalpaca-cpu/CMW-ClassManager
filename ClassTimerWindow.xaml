<Window x:Class="CMW.ClassTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课堂倒计时"
        Width="380" Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#1A1A1A"
        Topmost="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource GlobalFontFamily}">

    <Window.Resources>

        <Style x:Key="TimerBtn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#11FFFFFF"/>
                                <Setter Property="Foreground" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerBtnPrimary" TargetType="Button" BasedOn="{StaticResource TimerBtn}">
            <Setter Property="Background" Value="#1E5FD0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E6FDD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#174CA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#141414"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock Text="⏱ 课堂倒计时"
                           FontFamily="{DynamicResource GlobalFontFamily}"
                           FontSize="13"
                           Foreground="#A0FFFFFF"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="BtnPin"
                            Content="📌"
                            Click="BtnPin_Click"
                            Background="Transparent"
                            Foreground="#A0FFFFFF"
                            BorderThickness="0"
                            FontFamily="Segoe UI"
                            FontSize="14"
                            Width="32"
                            Height="28"
                            Cursor="Hand"
                            ToolTip="切换置顶"/>

                    <Button x:Name="BtnClose"
                            Content="✕"
                            Click="BtnClose_Click"
                            Background="Transparent"
                            Foreground="#A0FFFFFF"
                            BorderThickness="0"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Width="32"
                            Height="28"
                            Cursor="Hand"
                            ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="tbTime"
                       Text="05:00"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="tbStatus"
                       Text="就绪"
                       FontFamily="{DynamicResource GlobalFontFamily}"
                       FontSize="12"
                       Foreground="#80FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">
            <Button x:Name="BtnMinus"
                    Content="−1 分"
                    Click="BtnMinus_Click"
                    Style="{StaticResource TimerBtn}"
                    Margin="0,0,6,0"/>
            <Button x:Name="BtnPlus"
                    Content="+1 分"
                    Click="BtnPlus_Click"
                    Style="{StaticResource TimerBtn}"
                    Margin="0,0,6,0"/>
            <Button x:Name="BtnStartPause"
                    Content="开始"
                    Click="BtnStartPause_Click"
                    Style="{StaticResource TimerBtnPrimary}"
                    MinWidth="84"
                    Margin="0,0,6,0"/>
            <Button x:Name="BtnReset"
                    Content="重置"
                    Click="BtnReset_Click"
                    Style="{StaticResource TimerBtn}"/>
        </StackPanel>
    </Grid>
</Window>